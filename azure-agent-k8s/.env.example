# Azure DevOps Organization / TFS Collection URL
# Vi du: https://dev.azure.com/your-organization hoac https://tfs.your-domain.com/tfs/DefaultCollection
AZP_URL=https://dev.azure.com/your-organization

# Personal Access Token (PAT) voi quyen: Agent Pools (Read & manage)
AZP_TOKEN=your-personal-access-token

# Ten Agent Pool da tao san tren Azure DevOps
AZP_POOL=your-agent-pool

